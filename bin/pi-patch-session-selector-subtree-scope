session_picker_text = texts[SESSION_PICKER]
if '''import { resolve, sep } from "node:path";''' in session_picker_text and '''resolve as resolvePath''' not in session_picker_text:
    session_picker_text = session_picker_text.replace('''import { resolve, sep } from "node:path";''', '''import { resolve as resolvePath, sep } from "node:path";''')
    changed_paths.add(SESSION_PICKER)
    print("patched session-picker.js bad path import")
for old, new in [
    ('''const currentCwd = cwd ? resolve(cwd) : undefined;''', '''const currentCwd = cwd ? resolvePath(cwd) : undefined;'''),
    ('''const sessionCwd = resolve(session.cwd);''', '''const sessionCwd = resolvePath(session.cwd);'''),
]:
    if old in session_picker_text:
        session_picker_text = session_picker_text.replace(old, new)
        changed_paths.add(SESSION_PICKER)
        print("patched session-picker.js shadowed resolve call")
texts[SESSION_PICKER] = session_picker_text

