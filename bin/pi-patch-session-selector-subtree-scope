#!/usr/bin/env python3
from pathlib import Path
import os
import tempfile

SESSION_SELECTOR = Path(os.environ.get(
    "PI_SESSION_SELECTOR_PATH",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/modes/interactive/components/session-selector.js",
))
INTERACTIVE_MODE = Path(os.environ.get(
    "PI_INTERACTIVE_MODE_PATH",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/modes/interactive/interactive-mode.js",
))
SESSION_PICKER = Path(os.environ.get(
    "PI_SESSION_PICKER_PATH",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli/session-picker.js",
))
MAIN = Path(os.environ.get(
    "PI_MAIN_PATH",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/main.js",
))
paths = (SESSION_SELECTOR, INTERACTIVE_MODE, SESSION_PICKER, MAIN)
texts = {path: path.read_text("utf8") for path in paths}
changed_paths = set()


def patch_file(path: Path, patches):
    text = texts[path]
    for label, old, new, marker in patches:
        if marker and marker in text:
            print(f"skip {path.name} {label}: already patched")
            continue
        count = text.count(old)
        if count == 0 and new in text:
            print(f"skip {path.name} {label}: already patched")
            continue
        if count != 1:
            raise RuntimeError(f"{path} {label}: expected one match, found {count}")
        text = text.replace(old, new)
        changed_paths.add(path)
        print(f"patched {path.name} {label}")
    texts[path] = text


