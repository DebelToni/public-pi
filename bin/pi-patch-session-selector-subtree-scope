    (
        "startup subtree loader",
        '''        const selector = new SessionSelectorComponent(currentSessionsLoader, allSessionsLoader, (path) => {
''',
        '''        const currentCwd = cwd ? resolvePath(cwd) : undefined;
        const subtreeSessionsLoader = async (onProgress) => {
            const sessions = await allSessionsLoader(onProgress);
            if (!currentCwd)
                return sessions;
            return sessions.filter((session) => {
                const sessionCwd = resolvePath(session.cwd);
                return sessionCwd === currentCwd || sessionCwd.startsWith(`${currentCwd}${sep}`);
            });
        };
        const selector = new SessionSelectorComponent(currentSessionsLoader, subtreeSessionsLoader, allSessionsLoader, (path) => {
''',
        '''const subtreeSessionsLoader = async (onProgress) => {''',
    ),
]

main_patches = [
    (
        "pass cwd to startup selector",
        '''            const selectedPath = await selectSession((onProgress) => SessionManager.list(cwd, sessionDir, onProgress), (onProgress) => SessionManager.listAll(sessionDir, onProgress), settingsManager);
''',
        '''            const selectedPath = await selectSession((onProgress) => SessionManager.list(cwd, sessionDir, onProgress), (onProgress) => SessionManager.listAll(sessionDir, onProgress), settingsManager, cwd);
''',
        '''settingsManager, cwd);''',
    ),
]

patch_file(SESSION_SELECTOR, selector_patches)
if "createSessionCatalogBoundary" in texts[INTERACTIVE_MODE]:
    print("skip interactive-mode.js subtree loader: session catalog boundary owns it")
else:
    patch_file(INTERACTIVE_MODE, interactive_patches)
if "searchSessions" in texts[SESSION_PICKER]:
    print("skip session-picker.js subtree loader: session catalog boundary owns it")
else:
    patch_file(SESSION_PICKER, session_picker_patches)
if "createSessionCatalogBoundary" in texts[MAIN]:
    print("skip main.js startup subtree loader: session catalog boundary owns it")
else:
    patch_file(MAIN, main_patches)

for path in changed_paths:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as handle:
            handle.write(texts[path])
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, path.stat().st_mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise

if changed_paths:
    print("session selector subtree scope patch applied")
else:
    print("session selector subtree scope patch already present")
