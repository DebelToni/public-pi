#!/usr/bin/env python3
"""Patch Pi so queued steering and follow-up messages survive process crashes."""

from pathlib import Path
import os
import stat
import subprocess
import tempfile
import uuid

CODING_AGENT_ROOT = Path(os.environ.get(
    "PI_CODING_AGENT_ROOT",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent",
))
AGENT_CORE_ROOT = CODING_AGENT_ROOT / "node_modules/@earendil-works/pi-agent-core"
TARGETS = {
    "agent session": CODING_AGENT_ROOT / "dist/core/agent-session.js",
    "session manager": CODING_AGENT_ROOT / "dist/core/session-manager.js",
    "session manager types": CODING_AGENT_ROOT / "dist/core/session-manager.d.ts",
    "agent core": AGENT_CORE_ROOT / "dist/agent.js",
    "agent core types": AGENT_CORE_ROOT / "dist/agent.d.ts",
}
HELPER_SOURCE = Path(__file__).resolve().parent.parent / "core-patches/durable-message-queue.js"
HELPER_TARGET = CODING_AGENT_ROOT / "dist/core/durable-message-queue.js"
PROPER_LOCKFILE = CODING_AGENT_ROOT / "node_modules/proper-lockfile/index.js"

if not PROPER_LOCKFILE.is_file():
    raise RuntimeError(f"Pi's proper-lockfile dependency is unavailable: {PROPER_LOCKFILE}")
texts = {name: path.read_text("utf8") for name, path in TARGETS.items()}
changed: set[str] = set()


def replace_once(target: str, label: str, old: str, new: str, marker: str) -> None:
    replace_once_variant(target, label, ((old, new),), marker)


def replace_once_variant(
    target: str,
    label: str,
    variants: tuple[tuple[str, str], ...],
    marker: str,
) -> None:
    text = texts[target]
    if marker in text:
        print(f"skip {label}: already patched")
        return
    matches = [(old, new) for old, new in variants if text.count(old) == 1]
    if len(matches) != 1:
        count = sum(text.count(old) for old, _ in variants)
        raise RuntimeError(
            f"{label}: expected one compatible match in {TARGETS[target]}, found {count}"
        )
    old, new = matches[0]
    texts[target] = text.replace(old, new)
    changed.add(target)
    print(f"patched {label}")


