replace_once(
    "agent session",
    "durable queue cancellation",
    '''        this._steeringMessages = [];
        this._followUpMessages = [];
        this.agent.clearAllQueues();
        this._emitQueueUpdate();
''',
    '''        const queuedMessages = this.agent.getQueuedMessages();
        let discardFailures;
        try {
            discardFailures = this._durableMessageQueue.discardMessages(queuedMessages);
        }
        catch (error) {
            const message = error instanceof Error ? error.message : String(error);
            this._extensionUIContext?.notify(`Queued messages were not cleared because durable cancellation failed: ${message}`, "warning");
            return { steering: [], followUp: [] };
        }
        this.agent.clearAllQueues();
        this._steeringMessages = [];
        this._followUpMessages = [];
        if (discardFailures > 0) {
            this._extensionUIContext?.notify("Canceled queue cleanup is deferred to the next recovery.", "warning");
        }
        this._emitQueueUpdate();
''',
    "discardFailures = this._durableMessageQueue.discardMessages(",
)

