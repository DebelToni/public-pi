replace_once(
    "agent session",
    "durable user queues and recovery",
    '''    async _queueSteer(text, images) {
        this._steeringMessages.push(text);
        this._emitQueueUpdate();
        const content = [{ type: "text", text }];
        if (images) {
            content.push(...images);
        }
        this.agent.steer({
            role: "user",
            content,
            timestamp: Date.now(),
        });
    }
    /**
     * Internal: Queue a follow-up message (already expanded, no extension command check).
     */
    async _queueFollowUp(text, images) {
        this._followUpMessages.push(text);
        this._emitQueueUpdate();
        const content = [{ type: "text", text }];
        if (images) {
            content.push(...images);
        }
        this.agent.followUp({
            role: "user",
            content,
            timestamp: Date.now(),
        });
    }
''',
    '''    async _queueSteer(text, images) {
        const content = [{ type: "text", text }];
        if (images) {
            content.push(...images);
        }
        this._queueDurableMessage("steer", {
            role: "user",
            content,
            timestamp: Date.now(),
        });
        this._steeringMessages.push(text);
        this._emitQueueUpdate();
    }
    /**
     * Internal: Queue a follow-up message (already expanded, no extension command check).
     */
    async _queueFollowUp(text, images) {
        const content = [{ type: "text", text }];
        if (images) {
            content.push(...images);
        }
        this._queueDurableMessage("followUp", {
            role: "user",
            content,
            timestamp: Date.now(),
        });
        this._followUpMessages.push(text);
        this._emitQueueUpdate();
    }
    _queueDurableMessage(behavior, message) {
        const durableMessage = this._durableMessageQueue.enqueue(behavior, message);
        try {
            if (behavior === "followUp") {
                this.agent.followUp(durableMessage);
            }
            else {
                this.agent.steer(durableMessage);
            }
        }
        catch (error) {
            this._durableMessageQueue.discardMessages([durableMessage]);
            throw error;
        }
        return durableMessage;
    }
    _enqueueRecoveredMessage(record) {
        if (record.behavior === "followUp") {
            this.agent.followUp(record.message);
        }
        else {
            this.agent.steer(record.message);
        }
        if (record.message.role !== "user") return;
        const text = contentText(record.message.content, "");
        if (record.behavior === "followUp") {
            this._followUpMessages.push(text);
        }
        else {
            this._steeringMessages.push(text);
        }
    }
    async _recoverDurableMessages() {
        if (this._durableQueueRecoveryStarted) return;
        this._durableQueueRecoveryStarted = true;
        let recovery;
        try {
            recovery = await this._durableMessageQueue.loadRecoverable();
        }
        catch (error) {
            const message = error instanceof Error ? error.message : String(error);
            this._extensionUIContext?.notify(`Queued-message recovery failed; pending records were retained: ${message}`, "warning");
            return;
        }
        if (recovery.invalidCount > 0) {
            this._extensionUIContext?.notify(`${recovery.invalidCount} malformed durable queue record(s) were retained for inspection.`, "warning");
        }
        if (recovery.skippedScopeCount > 0) {
            this._extensionUIContext?.notify(`${recovery.skippedScopeCount} queued record(s) belong to another session file or branch and were left untouched.`, "warning");
        }
        if (recovery.records.length === 0) return;
        this._extensionUIContext?.notify(`Recovered ${recovery.records.length} queued message(s) from the interrupted session.`, "info");
        if (this.isStreaming) {
            for (const record of recovery.records) this._enqueueRecoveredMessage(record);
            this._emitQueueUpdate();
            return;
        }
        const steeringRecords = recovery.records.filter((record) => record.behavior === "steer");
        const initialCandidates = steeringRecords.length > 0
            ? steeringRecords
            : recovery.records;
        const initialMode = steeringRecords.length > 0
            ? this.agent.steeringMode
            : this.agent.followUpMode;
        const initialRecords = initialMode === "all" ? initialCandidates : initialCandidates.slice(0, 1);
        const initialIds = new Set(initialRecords.map((record) => record.id));
        const remaining = recovery.records.filter((record) => !initialIds.has(record.id));
        for (const record of remaining) this._enqueueRecoveredMessage(record);
        this._emitQueueUpdate();
        const recoveryPromise = this._runAgentPrompt(initialRecords.map((record) => record.message), true).catch((error) => {
            const message = error instanceof Error ? error.message : String(error);
            this._extensionUIContext?.notify(`Recovered queued messages remain durable after delivery failed: ${message}`, "warning");
        });
        this._durableRecoveryPromise = recoveryPromise;
        void recoveryPromise.finally(() => {
            if (this._durableRecoveryPromise === recoveryPromise) this._durableRecoveryPromise = undefined;
        });
    }
''',
    "_recoverDurableMessages() {",
)

