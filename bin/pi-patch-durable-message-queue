def validate_javascript(label: str, text: str) -> None:
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf8", suffix=".mjs", dir="/tmp", delete=False) as handle:
            handle.write(text)
            temporary = handle.name
        result = subprocess.run(
            ["node", "--check", temporary],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"{label}: generated invalid JavaScript: {result.stderr.strip()}")
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def atomic_replace(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
    fd = None
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        offset = 0
        while offset < len(data):
            written = os.write(fd, data[offset:])
            if written <= 0:
                raise OSError("short write while installing durable queue patch")
            offset += written
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(temporary, path)
        try:
            directory_fd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except OSError:
            # The validated atomic replacement is already visible. Keep it accepted
            # so rerunning the patch cannot observe a reported-failure ghost.
            pass
    except BaseException:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


if not HELPER_SOURCE.is_file():
    raise RuntimeError(f"missing durable queue helper: {HELPER_SOURCE}")
for name in changed:
    if TARGETS[name].suffix == ".js":
        validate_javascript(name, texts[name])
validate_javascript("durable queue helper", HELPER_SOURCE.read_text("utf8"))

for name in changed:
    target = TARGETS[name]
    mode = stat.S_IMODE(target.stat().st_mode)
    atomic_replace(target, texts[name].encode("utf8"), mode)

atomic_replace(HELPER_TARGET, HELPER_SOURCE.read_bytes(), 0o644)
print(f"installed durable queue helper: {HELPER_TARGET}")
