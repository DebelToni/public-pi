replace_once(
    "session manager",
    "materialize pending session before durable queue acceptance",
    '''    getSessionFile() {
        return this.sessionFile;
    }
    _persist(entry) {
''',
    '''    getSessionFile() {
        return this.sessionFile;
    }
    flushPendingEntries() {
        if (!this.persist || !this.sessionFile || this.flushed)
            return;
        const temporaryPath = `${this.sessionFile}.${process.pid}.${randomUUID()}.tmp`;
        let fd;
        try {
            fd = openSync(temporaryPath, "wx");
            for (const entry of this.fileEntries) {
                writeFileSync(fd, `${JSON.stringify(entry)}\n`);
            }
            fsyncSync(fd);
            closeSync(fd);
            fd = undefined;
            linkSync(temporaryPath, this.sessionFile);
            this.flushed = true;
            unlinkSync(temporaryPath);
            const directoryFd = openSync(dirname(this.sessionFile), "r");
            try {
                fsyncSync(directoryFd);
            }
            finally {
                closeSync(directoryFd);
            }
        }
        catch (error) {
            if (fd !== undefined) {
                try {
                    closeSync(fd);
                }
                catch {
                    // Preserve the original write failure.
                }
            }
            try {
                unlinkSync(temporaryPath);
            }
            catch {
                // The temporary link may already have been removed.
            }
            throw error;
        }
    }
    _persist(entry) {
''',
    "flushPendingEntries() {",
)

