#!/usr/bin/env python3
"""Patch Pi to retry the exact Codex server-overload response after three minutes."""

from pathlib import Path
import os
import stat
import subprocess
import tempfile
import uuid

CODING_AGENT_ROOT = Path(os.environ.get(
    "PI_CODING_AGENT_ROOT",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent",
))
TARGET = Path(os.environ.get(
    "PI_AGENT_SESSION_PATH",
    str(CODING_AGENT_ROOT / "dist/core/agent-session.js"),
))
text = TARGET.read_text("utf8")
changed = False


def replace_once(label, old, new, marker):
    global text, changed
    if marker in text:
        print("skip %s: already patched" % label)
        return
    count = text.count(old)
    if count != 1:
        raise RuntimeError("%s: expected one match in %s, found %d" % (label, TARGET, count))
    text = text.replace(old, new)
    changed = True
    print("patched %s" % label)


replace_once(
    "exact Codex overload predicate",
    '''    _isRetryableError(message) {
''',
    '''    _isExactCodexOverload(message) {
        return message.api === "openai-codex-responses" &&
            message.stopReason === "error" &&
            (message.provider === "openai-codex" || message.provider?.startsWith("codex-")) &&
            message.errorMessage?.trim() === "Codex error: Our servers are currently overloaded. Please try again later.";
    }
    _isRetryableError(message) {
''',
    '''    _isExactCodexOverload(message) {''',
)

replace_once(
    "three-minute Codex overload delay",
    '''        const delayMs = settings.baseDelayMs * 2 ** (this._retryAttempt - 1);
''',
    '''        const delayMs = this._isExactCodexOverload(message)
            ? 180_000
            : settings.baseDelayMs * 2 ** (this._retryAttempt - 1);
''',
    '''? 180_000
            : settings.baseDelayMs * 2 ** (this._retryAttempt - 1);''',
)

replace_once(
    "retry wait description",
    '''        // Wait with exponential backoff (abortable)
''',
    '''        // Wait for the selected retry delay (abortable).
''',
    '''// Wait for the selected retry delay (abortable).''',
)


def validate_javascript(data):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf8", suffix=".mjs", dir="/tmp", delete=False) as handle:
            handle.write(data)
            temporary = handle.name
        result = subprocess.run(
            ["node", "--check", temporary],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError("generated invalid JavaScript: %s" % result.stderr.strip())
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def atomic_replace(path, data, mode):
    temporary = path.with_name(".%s.%d.%s.tmp" % (path.name, os.getpid(), uuid.uuid4().hex))
    descriptor = None
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        offset = 0
        while offset < len(data):
            written = os.write(descriptor, data[offset:])
            if written <= 0:
                raise OSError("short write while installing Codex overload retry patch")
            offset += written
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        os.replace(temporary, path)
        try:
            directory_descriptor = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_descriptor)
            finally:
                os.close(directory_descriptor)
        except OSError:
            pass
    except BaseException:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


if changed:
    validate_javascript(text)
    atomic_replace(TARGET, text.encode("utf8"), stat.S_IMODE(TARGET.stat().st_mode))
    print("wrote %s" % TARGET)
else:
    print("Codex overload retry patch already present")
