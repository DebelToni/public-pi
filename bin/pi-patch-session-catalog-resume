MAIN = Path(os.environ.get("PI_MAIN_PATH", ROOT / "dist/main.js"))

paths = (SELECTOR, SELECTOR_TYPES, PICKER, PICKER_TYPES, INTERACTIVE, MAIN)
texts = {path: path.read_text("utf8") for path in paths}
runtime_text = RUNTIME_CLIENT_SOURCE.read_text("utf8")
changed_paths = set()


def replace_once(path: Path, label: str, old: str, new: str, marker: Optional[str] = None):
    text = texts[path]
    if marker and marker in text:
        print(f"skip {path.name} {label}: already patched")
        return
    count = text.count(old)
    if count == 0 and new in text:
        print(f"skip {path.name} {label}: already patched")
        return
    if count != 1:
        raise RuntimeError(f"{path} {label}: expected one match, found {count}")
    texts[path] = text.replace(old, new)
    changed_paths.add(path)
    print(f"patched {path.name} {label}")


def replace_if_present(path, label, old, new):
    if old not in texts[path]:
        return
    if texts[path].count(old) != 1:
        raise SystemExit(f"expected exactly one {label} block in {path}, found {texts[path].count(old)}")
    texts[path] = texts[path].replace(old, new, 1)
    changed_paths.add(path)
    print(f"patched {path.name} {label}")


