    }, currentSessionFilePath?: string);
''',
    '''searchSessions?: CatalogSessionSearch''',
)

replace_once(
    PICKER_TYPES,
    "startup picker catalog types",
    '''export declare function selectSession(currentSessionsLoader: SessionsLoader, allSessionsLoader: SessionsLoader, settingsManager: SettingsManager): Promise<string | null>;''',
    '''export declare function selectSession(currentSessionsLoader: SessionsLoader, allSessionsLoader: SessionsLoader, settingsManager: SettingsManager, cwd?: string, searchSessions?: (query: string, options: {
    scope: "current" | "subtree" | "all";
    sortMode: "threaded" | "recent" | "relevance";
    nameFilter: "all" | "named";
    signal: AbortSignal;
}) => Promise<SessionInfo[]>): Promise<string | null>;''',
    '''searchSessions?: (query: string''',
)

# Validate every replacement before writing. Runtime client and patched targets use atomic same-directory replacement.
for path in changed_paths:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as handle:
            handle.write(texts[path])
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, path.stat().st_mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise

if not RUNTIME_CLIENT.exists() or RUNTIME_CLIENT.read_text("utf8") != runtime_text:
    RUNTIME_CLIENT.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{RUNTIME_CLIENT.name}.", suffix=".tmp", dir=RUNTIME_CLIENT.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as handle:
            handle.write(runtime_text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, RUNTIME_CLIENT)
        print(f"installed {RUNTIME_CLIENT.name}")
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
else:
    print(f"skip {RUNTIME_CLIENT.name}: already current")

if changed_paths:
    print("session catalog resume patch applied")
else:
    print("session catalog resume patch already present")
