replace_once(
    SELECTOR,
    "external catalog search results",
    '''    setSessions(sessions, showCwd) {
        const selectedPath = this.getSelectedSessionPath();
        this.allSessions = sessions;
        this.showCwd = showCwd;
        this.filterSessions(this.searchInput.getValue());
        if (selectedPath)
            this.selectSessionPath(selectedPath);
    }
    filterSessions(query) {
        const trimmed = query.trim();
        const nameFiltered = this.nameFilter === "all" ? this.allSessions : this.allSessions.filter((session) => hasSessionName(session));
        if (this.sortMode === "threaded" && !trimmed) {
            // Threaded mode without search: show tree structure
            const roots = buildSessionTree(nameFiltered);
            this.filteredSessions = flattenSessionTree(roots, this.expandedChains);
        }
        else {
            // Other modes or with search: flat list
            const filtered = filterAndSortSessions(nameFiltered, query, this.sortMode, "all");
            this.filteredSessions = filtered.map((session) => ({
                session,
                displayModified: getOwnModified(session),
                depth: 0,
                isLast: true,
                ancestorContinues: [],
                collapsedAncestors: 0,
            }));
        }
        this.selectedIndex = Math.min(this.selectedIndex, Math.max(0, this.filteredSessions.length - 1));
    }
''',
    '''    setSessions(sessions, showCwd) {
        const selectedPath = this.getSelectedSessionPath();
        this.allSessions = sessions;
        this.showCwd = showCwd;
        this.filterSessions(this.searchInput.getValue());
        if (selectedPath)
            this.selectSessionPath(selectedPath);
    }
    getSearchQuery() {
        return this.searchInput.getValue().trim();
    }
    clearSearchResults() {
        this.externalSearch = null;
        this.filterSessions(this.searchInput.getValue());
    }
    setSearchResults(query, sessions) {
        const trimmed = query.trim();
        if (!trimmed || this.getSearchQuery() !== trimmed)
            return;
        const selectedPath = this.getSelectedSessionPath();
        this.externalSearch = { query: trimmed, sessions };
        this.filterSessions(trimmed);
        if (selectedPath)
            this.selectSessionPath(selectedPath);
    }
    filterSessions(query) {
        const trimmed = query.trim();
        const external = trimmed && this.externalSearch?.query === trimmed ? this.externalSearch.sessions : null;
        const source = external ?? this.allSessions;
        const nameFiltered = this.nameFilter === "all" ? source : source.filter((session) => hasSessionName(session));
        if (this.sortMode === "threaded" && !trimmed) {
            // Threaded mode without search: show tree structure
            const roots = buildSessionTree(nameFiltered);
            this.filteredSessions = flattenSessionTree(roots, this.expandedChains);
        }
        else {
            // Catalog search results are already ranked; fallback sessions retain the built-in matcher.
            const filtered = external ? nameFiltered : filterAndSortSessions(nameFiltered, query, this.sortMode, "all");
            this.filteredSessions = filtered.map((session) => ({
                session,
                displayModified: getOwnModified(session),
                depth: 0,
                isLast: true,
                ancestorContinues: [],
                collapsedAncestors: 0,
            }));
        }
        this.selectedIndex = Math.min(this.selectedIndex, Math.max(0, this.filteredSessions.length - 1));
    }
''',
    '''setSearchResults(query, sessions) {''',
)

