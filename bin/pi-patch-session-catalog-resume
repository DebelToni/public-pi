replace_once(
    SELECTOR,
    "debounced cancellable catalog search",
    '''    mergeProgressSessions(scope, available) {
        const existing = this.progressSessionCaches[scope] ?? [];
        const byPath = new Map(existing.map((session) => [session.path, session]));
        for (const session of available)
            byPath.set(session.path, session);
        const sessions = [...byPath.values()].sort((a, b) => b.modified.getTime() - a.modified.getTime());
        this.progressSessionCaches[scope] = sessions;
        if (scope === "current")
            this.currentSessions = sessions;
        else if (scope === "subtree")
            this.subtreeSessions = sessions;
        else
            this.allSessions = sessions;
        return sessions;
    }
    enterRenameMode(sessionPath, currentName) {
''',
    '''    mergeProgressSessions(scope, available) {
        const existing = this.progressSessionCaches[scope] ?? [];
        const byPath = new Map(existing.map((session) => [session.path, session]));
        for (const session of available)
            byPath.set(session.path, session);
        const sessions = [...byPath.values()].sort((a, b) => b.modified.getTime() - a.modified.getTime());
        this.progressSessionCaches[scope] = sessions;
        if (scope === "current")
            this.currentSessions = sessions;
        else if (scope === "subtree")
            this.subtreeSessions = sessions;
        else
            this.allSessions = sessions;
        return sessions;
    }
    cancelCatalogSearch() {
        if (this.searchTimer !== null) {
            clearTimeout(this.searchTimer);
            this.searchTimer = null;
        }
        this.searchAbort?.abort();
        this.searchAbort = null;
        this.searchSeq++;
    }
    scheduleCatalogSearch(query, immediate = false) {
        this.cancelCatalogSearch();
        const trimmed = query.trim();
        if (!this.searchSessions || !trimmed) {
            this.sessionList.clearSearchResults();
            this.requestRender();
            return;
        }
        const seq = this.searchSeq;
        const scope = this.scope;
        const sortMode = this.sortMode;
        const nameFilter = this.nameFilter;
        const run = async () => {
            this.searchTimer = null;
            const controller = new AbortController();
            this.searchAbort = controller;
            try {
                const sessions = await this.searchSessions(trimmed, { scope, sortMode, nameFilter, signal: controller.signal });
                if (controller.signal.aborted || seq !== this.searchSeq || scope !== this.scope || trimmed !== this.sessionList.getSearchQuery())
                    return;
                this.sessionList.setSearchResults(trimmed, sessions);
                this.requestRender();
            }
            catch (error) {
                if (controller.signal.aborted || error?.name === "AbortError")
                    return;
                this.sessionList.onError?.(`Catalog search failed: ${error instanceof Error ? error.message : String(error)}`);
            }
            finally {
                if (this.searchAbort === controller)
                    this.searchAbort = null;
            }
        };
        this.searchTimer = setTimeout(() => void run(), immediate ? 0 : 120);
    }
    enterRenameMode(sessionPath, currentName) {
''',
    '''scheduleCatalogSearch(query, immediate = false) {''',
)

