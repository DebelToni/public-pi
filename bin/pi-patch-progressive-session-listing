# Every replacement is validated before any target is changed. Writes use same-directory atomic replacement.
for path in changed_paths:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as handle:
            handle.write(texts[path])
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, path.stat().st_mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise

if changed_paths:
    print("progressive session listing patch applied")
else:
    print("progressive session listing patch already present")
