#!/usr/bin/env python3
from pathlib import Path
import os
import tempfile
from typing import Optional

ROOT = Path(os.environ.get(
    "PI_CODING_AGENT_ROOT",
    "/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent",
))
SESSION_MANAGER = Path(os.environ.get(
    "PI_SESSION_MANAGER_PATH",
    ROOT / "dist/core/session-manager.js",
))
SESSION_MANAGER_TYPES = Path(os.environ.get(
    "PI_SESSION_MANAGER_TYPES_PATH",
    ROOT / "dist/core/session-manager.d.ts",
))
SESSION_SELECTOR = Path(os.environ.get(
    "PI_SESSION_SELECTOR_PATH",
    ROOT / "dist/modes/interactive/components/session-selector.js",
))
SESSION_PICKER = Path(os.environ.get(
    "PI_SESSION_PICKER_PATH",
    ROOT / "dist/cli/session-picker.js",
))
INTERACTIVE_MODE = Path(os.environ.get(
    "PI_INTERACTIVE_MODE_PATH",
    ROOT / "dist/modes/interactive/interactive-mode.js",
))

texts = {
    path: path.read_text("utf8")
    for path in (SESSION_MANAGER, SESSION_MANAGER_TYPES, SESSION_SELECTOR, SESSION_PICKER, INTERACTIVE_MODE)
}
changed_paths = set()


def replace_once(path: Path, label: str, old: str, new: str, marker: Optional[str] = None):
    text = texts[path]
    if marker and marker in text:
        print(f"skip {path.name} {label}: already patched")
        return
    count = text.count(old)
    if count == 0 and new in text:
        print(f"skip {path.name} {label}: already patched")
        return
    if count != 1:
        raise RuntimeError(f"{path} {label}: expected one match, found {count}")
    texts[path] = text.replace(old, new)
    changed_paths.add(path)
    print(f"patched {path.name} {label}")


replace_once(
    SESSION_MANAGER,
    "newest-first file ordering",
    '''const MAX_CONCURRENT_SESSION_INFO_LOADS = 10;
async function buildSessionInfosWithConcurrency(files, onLoaded) {
    const results = new Array(files.length).fill(null);
    const inFlight = new Set();
    let nextIndex = 0;
    const startNext = () => {
        const index = nextIndex++;
        const file = files[index];
        if (!file)
            return;
        let task;
        task = buildSessionInfo(file)
            .then((info) => {
            results[index] = info;
        })
            .catch(() => {
            results[index] = null;
        })
            .finally(() => {
            inFlight.delete(task);
            onLoaded();
        });
        inFlight.add(task);
    };
    while (nextIndex < files.length || inFlight.size > 0) {
        while (nextIndex < files.length && inFlight.size < MAX_CONCURRENT_SESSION_INFO_LOADS) {
            startNext();
        }
        if (inFlight.size > 0) {
            await Promise.race(inFlight);
        }
    }
    return results;
}
''',
    '''const MAX_CONCURRENT_SESSION_METADATA_LOADS = 32;
async function sortSessionFilesNewestFirst(files) {
    const dated = new Array(files.length);
    let nextIndex = 0;
    const workers = Array.from({ length: Math.min(files.length, MAX_CONCURRENT_SESSION_METADATA_LOADS) }, async () => {
        while (nextIndex < files.length) {
            const index = nextIndex++;
            const path = files[index];
            try {
                dated[index] = { path, mtimeMs: (await stat(path)).mtimeMs };
            }
            catch {
                dated[index] = { path, mtimeMs: Number.NEGATIVE_INFINITY };
            }
        }
    });
    await Promise.all(workers);
    return dated
        .sort((a, b) => b.mtimeMs - a.mtimeMs || a.path.localeCompare(b.path))
        .map(({ path }) => path);
}
const MAX_CONCURRENT_SESSION_INFO_LOADS = 10;
async function buildSessionInfosWithConcurrency(files, onLoaded) {
    const results = new Array(files.length);
    const inFlight = new Set();
    const initialLoadLimit = Math.min(files.length, MAX_CONCURRENT_SESSION_INFO_LOADS);
    let nextIndex = 0;
    let nextPublishedIndex = 0;
    let hasPublished = false;
    const startNext = () => {
        const index = nextIndex++;
        const file = files[index];
        if (!file)
            return;
        let task;
        task = buildSessionInfo(file)
            .then((info) => {
            results[index] = info;
        })
            .catch(() => {
            results[index] = null;
        })
            .finally(() => {
            inFlight.delete(task);
            const available = [];
            while (nextPublishedIndex < results.length && results[nextPublishedIndex] !== undefined) {
                const info = results[nextPublishedIndex++];
                if (info)
                    available.push(info);
            }
            if (available.length > 0)
                hasPublished = true;
            onLoaded(available);
        });
        inFlight.add(task);
    };
    while (nextIndex < files.length || inFlight.size > 0) {
        const loadLimit = hasPublished || nextPublishedIndex >= initialLoadLimit ? files.length : initialLoadLimit;
        while (nextIndex < loadLimit && inFlight.size < MAX_CONCURRENT_SESSION_INFO_LOADS) {
            startNext();
        }
        if (inFlight.size > 0) {
            await Promise.race(inFlight);
        }
    }
    return results;
}
''',
    '''function sortSessionFilesNewestFirst(files)''',
)

replace_once(
    SESSION_MANAGER,
    "lightweight newest-session previews",
    '''const MAX_CONCURRENT_SESSION_METADATA_LOADS = 32;
''',
    '''const SESSION_PREVIEW_BYTES = 256 * 1024;
const SESSION_PREVIEW_COUNT = 10;
async function buildSessionPreview(filePath) {
    try {
        const stats = await stat(filePath);
        let header = null;
        let name;
        let firstMessage = "";
        const rl = createInterface({
            input: createReadStream(filePath, { encoding: "utf8", start: 0, end: SESSION_PREVIEW_BYTES - 1 }),
            crlfDelay: Infinity,
        });
        for await (const line of rl) {
            const entry = parseSessionEntryLine(line);
            if (!entry)
                continue;
            if (!header) {
                if (entry.type !== "session")
                    return null;
                header = entry;
                continue;
            }
            if (entry.type === "session_info") {
                name = entry.name?.trim() || undefined;
                continue;
            }
            if (entry.type !== "message" || entry.message?.role !== "user" || !isMessageWithContent(entry.message))
                continue;
            firstMessage = extractTextContent(entry.message);
            if (firstMessage)
                break;
        }
        if (!header)
            return null;
        return {
            path: filePath,
            id: header.id,
            cwd: typeof header.cwd === "string" ? header.cwd : "",
            name,
            parentSessionPath: header.parentSession,
            created: new Date(header.timestamp),
            modified: stats.mtime,
            messageCount: 0,
            firstMessage: firstMessage || "(loading session…)",
            allMessagesText: firstMessage,
            partial: true,
        };
    }
    catch {
        return null;
    }
}
const MAX_CONCURRENT_SESSION_PREVIEW_LOADS = 16;
async function buildSessionPreviews(files, limit = SESSION_PREVIEW_COUNT) {
    const selected = files.slice(0, limit);
    const previews = new Array(selected.length);
    let nextIndex = 0;
    const workers = Array.from({ length: Math.min(selected.length, MAX_CONCURRENT_SESSION_PREVIEW_LOADS) }, async () => {
        while (nextIndex < selected.length) {
            const index = nextIndex++;
            previews[index] = await buildSessionPreview(selected[index]);
        }
    });
    await Promise.all(workers);
    return previews.filter((preview) => preview !== null);
}
const MAX_CONCURRENT_SESSION_METADATA_LOADS = 32;
''',
    '''async function buildSessionPreview(filePath)''',
)






