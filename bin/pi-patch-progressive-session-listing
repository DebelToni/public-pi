                return;
            this.header.setProgress(loaded, total);
            const renderedCount = this.progressRenderedCounts[scope];
            if (sessions && (renderedCount === 0 || sessions.length - renderedCount >= 25 || loaded === total)) {
                this.sessionList.setSessions(sessions, showCwd);
                this.progressRenderedCounts[scope] = sessions.length;
