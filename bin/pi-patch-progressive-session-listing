        const target = canonicalizePath(path) ?? path;
        const idx = this.filteredSessions.findIndex((node) => (canonicalizePath(node.session.path) ?? node.session.path) === target);
        if (idx !== -1) this.selectedIndex = idx;
    }
''',
    '''    selectSessionPath(path) {
        const target = canonicalizePath(path) ?? path;
        let idx = this.filteredSessions.findIndex((node) => (canonicalizePath(node.session.path) ?? node.session.path) === target);
        if (idx === -1 && this.sortMode === "threaded" && !this.searchInput.getValue().trim()) {
            const collapsed = this.filteredSessions.find((node) => node.chainKey && node.chainPaths?.includes(target));
            if (collapsed) {
                this.expandedChains.add(collapsed.chainKey);
                this.filterSessions(this.searchInput.getValue());
                idx = this.filteredSessions.findIndex((node) => (canonicalizePath(node.session.path) ?? node.session.path) === target);
            }
        }
        if (idx !== -1)
            this.selectedIndex = idx;
    }
''',
