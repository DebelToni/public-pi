def validate_javascript(data):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf8", suffix=".mjs", dir="/tmp", delete=False) as handle:
            handle.write(data)
            temporary = handle.name
        result = subprocess.run(
            ["node", "--check", temporary],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError("generated invalid JavaScript: %s" % result.stderr.strip())
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def atomic_replace(path, data, mode):
    temporary = path.with_name(".%s.%d.%s.tmp" % (path.name, os.getpid(), uuid.uuid4().hex))
    descriptor = None
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        offset = 0
        while offset < len(data):
            written = os.write(descriptor, data[offset:])
            if written <= 0:
                raise OSError("short write while installing awaitable sendMessage patch")
            offset += written
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        os.replace(temporary, path)
        try:
            directory_descriptor = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_descriptor)
            finally:
                os.close(directory_descriptor)
        except OSError:
            pass
    except BaseException:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


for name in ("runtime", "loader"):
    if name in changed:
        validate_javascript(texts[name])
for name in changed:
    target = TARGETS[name]
    atomic_replace(target, texts[name].encode("utf8"), stat.S_IMODE(target.stat().st_mode))
    print("wrote %s" % target)
if not changed:
    print("awaitable extension sendMessage patch already present")
