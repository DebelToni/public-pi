#!/usr/bin/env python3
"""Patch Pi so extension sendMessage callers can await the triggered agent run."""

from pathlib import Path
import os
import stat
import subprocess
import tempfile
import uuid

root_value = os.environ.get("PI_CODING_AGENT_ROOT")
if not root_value:
    raise RuntimeError("PI_CODING_AGENT_ROOT is required")
ROOT = Path(root_value)
TARGETS = {
    "runtime": ROOT / "dist/core/agent-session.js",
    "loader": ROOT / "dist/core/extensions/loader.js",
    "types": ROOT / "dist/core/extensions/types.d.ts",
}
texts = {name: path.read_text("utf8") for name, path in TARGETS.items()}
changed = set()


def replace_once(target, label, old, new, marker):
    replace_once_variant(target, label, ((old, new),), marker)


def replace_once_variant(target, label, variants, marker):
    if marker in texts[target]:
        print("skip %s: already patched" % label)
        return
    matches = [(old, new) for old, new in variants if texts[target].count(old) == 1]
    if len(matches) != 1:
        count = sum(texts[target].count(old) for old, _ in variants)
        raise RuntimeError(
            "%s: expected one compatible match in %s, found %d" % (label, TARGETS[target], count)
        )
    old, new = matches[0]
    texts[target] = texts[target].replace(old, new)
    changed.add(target)
    print("patched %s" % label)


replace_once(
    "runtime",
    "awaitable extension sendMessage runtime",
    '''            sendMessage: (message, options) => {
                this.sendCustomMessage(message, options).catch((err) => {
                    runner.emitError({
